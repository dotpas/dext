<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <Base>True</Base>
        <AppType>Package</AppType>
        <Config Condition="'$(Config)'==''">Release</Config>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>Dext.Testing.Design.Cpp.dpk</MainSource>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <ProjectGuid>{A7C2E91F-3D44-4B8A-9E12-CPPDEXT00001}</ProjectGuid>
        <ProjectName Condition="'$(ProjectName)'==''">Dext.Testing.Design.Cpp</ProjectName>
        <ProjectVersion>20.5</ProjectVersion>
        <TargetedPlatforms>3</TargetedPlatforms>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>Dext_Testing_Design_Cpp</SanitizedProjectName>
        <DCC_BplOutput>..\..\Output\22.0\$(Platform)\$(Config)</DCC_BplOutput>
        <DCC_DcpOutput>..\..\Output\22.0\$(Platform)\$(Config)</DCC_DcpOutput>
        <DCC_DcuOutput>..\..\Output\22.0\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_Description>Dext Framework - Test Explorer for C++Builder (scaffold)</DCC_Description>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Vcl;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>..\..\Sources\Testing\Design.Cpp;$(BDS)\source\ToolsAPI;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DesignOnlyPackage>true</DesignOnlyPackage>
        <DllSuffix>$(Auto)</DllSuffix>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <DCC_UsePackage>rtl;designide;vcl;Dext.Core;$(DCC_UsePackage)</DCC_UsePackage>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="designide.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="Dext.Core.dcp"/>
        <DCCReference Include="..\..\Sources\Testing\Design.Cpp\Dext.Testing.Design.Cpp.Registration.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">Dext.Testing.Design.Cpp.dpk</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
    </ProjectExtensions>
</Project>
