unit Dext.Entity.PostgreSQL.Tests;

{***************************************************************************}
{  Tests that need a real PostgreSQL server. They run only when the         }
{  environment variable DEXT_TEST_PG is set to a FireDAC connection string  }
{  (including Database=...); otherwise each test returns at once.           }
{  DEXT_TEST_PG_VENDORLIB optionally points to the libpq.dll to load.       }
{                                                                           }
{  Regression: EnsureCreated used the metadata listing of FireDAC to decide }
{  whether a table exists, and that listing includes the other schemas. A   }
{  table with the same name in another schema made EnsureCreated skip the   }
{  CREATE TABLE, so the current schema stayed without the table.            }
{***************************************************************************}

interface

uses
  Winapi.Windows,
  System.SysUtils,
  Dext.Testing.Attributes,
  Dext.Assertions,
  Dext.Entity,
  Dext.Entity.Attributes,
  Dext.Entity.Core,
  Dext.Entity.Setup,
  Dext.Entity.Drivers.Interfaces,
  Dext.Entity.Drivers.FireDAC,
  Dext.Entity.Scaffolding,
  FireDAC.Stan.Intf,
  FireDAC.Phys.PG,
  FireDAC.Phys.PGDef;

type
  [Table('pg_schema_thing')]
  TPgSchemaThing = class
  private
    FId: Integer;
    FName: string;
  public
    [PrimaryKey]
    property Id: Integer read FId write FId;
    property Name: string read FName write FName;
  end;

  [Table('pg_array_thing')]
  TPgArrayThing = class
  private
    FId: Integer;
    FTags: TArray<string>;
    FIdent: TGUID;
  public
    [PrimaryKey, AutoInc]
    property Id: Integer read FId write FId;
    property Tags: TArray<string> read FTags write FTags;
    property Ident: TGUID read FIdent write FIdent;
  end;

  // An assigned (not generated) key: several rows go through the array insert.
  [Table('pg_guid_batch')]
  TPgGuidBatch = class
  private
    FId: Integer;
    FIdent: TGUID;
    FTags: TArray<string>;
  public
    [PrimaryKey]
    property Id: Integer read FId write FId;
    property Ident: TGUID read FIdent write FIdent;
    property Tags: TArray<string> read FTags write FTags;
  end;

  TPgGuidBatchDb = class(TDbContext)
  private
    function GetItems: IDbSet<TPgGuidBatch>;
  public
    property Items: IDbSet<TPgGuidBatch> read GetItems;
  end;

  TPgArrayDb = class(TDbContext)
  private
    function GetItems: IDbSet<TPgArrayThing>;
  public
    property Items: IDbSet<TPgArrayThing> read GetItems;
  end;

  // The only mapped column is the generated key: the INSERT has nothing to write.
  [Table('pg_only_key')]
  TPgOnlyKey = class
  private
    FId: Integer;
  public
    [PrimaryKey, AutoInc]
    property Id: Integer read FId write FId;
  end;

  TPgOnlyKeyDb = class(TDbContext)
  private
    function GetItems: IDbSet<TPgOnlyKey>;
  public
    property Items: IDbSet<TPgOnlyKey> read GetItems;
  end;

  TPgSchemaDb = class(TDbContext)
  private
    function GetThings: IDbSet<TPgSchemaThing>;
  public
    property Things: IDbSet<TPgSchemaThing> read GetThings;
  end;

  [TestFixture('PostgreSQL: tables and schemas')]
  TPostgreSQLSchemaTests = class
  private
    function Connection: string;
    function NewDb: TPgSchemaDb;
    function RelationExists(Db: TPgSchemaDb; const ASchema: string): Boolean;
  public
    [Test]
    [Description('EnsureCreated creates the table in the current schema even when another schema has one with the same name')]
    procedure EnsureCreated_Ignores_A_Table_Of_Another_Schema;
    [Test]
    [Description('A TArray<string> property is written to a jsonb column and read back')]
    procedure Dynamic_Array_Round_Trips_Through_Jsonb;
    [Test]
    [Description('A TGUID written to a uuid column is read back with the same value')]
    procedure Guid_Round_Trips_Through_A_Uuid_Column;
    [Test]
    [Description('Several entities with a TGUID are inserted in one SaveChanges')]
    procedure Guids_Of_Several_Entities_Are_Inserted_Together;
    [Test]
    [Description('Several entities with a TArray (jsonb) are inserted in one SaveChanges')]
    procedure Arrays_Of_Several_Entities_Are_Inserted_Together;
    [Test]
    [Description('An entity whose only column is the generated key is inserted with DEFAULT VALUES')]
    procedure Entity_With_Only_The_Generated_Key_Is_Inserted;
    [Test]
    [Description('Scaffolding reads a GENERATED AS IDENTITY column as generated by the database')]
    procedure Scaffolding_Reads_Identity_Columns_As_AutoInc;
  end;

implementation

var
  GLink: TFDPhysPgDriverLink;

function TPgSchemaDb.GetThings: IDbSet<TPgSchemaThing>;
begin
  Result := Entities<TPgSchemaThing>;
end;

function TPostgreSQLSchemaTests.Connection: string;
begin
  Result := GetEnvironmentVariable('DEXT_TEST_PG');
end;

function TPostgreSQLSchemaTests.NewDb: TPgSchemaDb;
var
  Lib: string;
begin
  if GLink = nil then
  begin
    GLink := TFDPhysPgDriverLink.Create(nil);
    Lib := GetEnvironmentVariable('DEXT_TEST_PG_VENDORLIB');
    if Lib <> '' then
    begin
      SetEnvironmentVariable('PATH', PChar(ExtractFilePath(Lib) + ';' +
        GetEnvironmentVariable('PATH')));
      GLink.VendorLib := Lib;
    end;
  end;
  Result := TPgSchemaDb.Create(DbContextOptions.UsePostgreSQL(Connection));
end;

function TPostgreSQLSchemaTests.RelationExists(Db: TPgSchemaDb;
  const ASchema: string): Boolean;
var
  Reader: IDbReader;
begin
  Reader := Db.Connection.CreateCommand(
    'SELECT COUNT(*) FROM information_schema.tables ' +
    'WHERE table_schema = ''' + ASchema + ''' ' +
    'AND table_name = ''pg_schema_thing''').ExecuteQuery;
  Reader.Next;
  Result := Reader.GetInt32(0) = 1;
end;

procedure TPostgreSQLSchemaTests.EnsureCreated_Ignores_A_Table_Of_Another_Schema;
var
  DbA, DbB: TPgSchemaDb;
begin
  if Connection = '' then
    Exit; // no server configured

  DbA := NewDb;
  DbB := NewDb;
  try
    DbA.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_a CASCADE').Execute;
    DbA.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_b CASCADE').Execute;
    DbA.Connection.CreateCommand('CREATE SCHEMA dext_ut_a').Execute;
    DbA.Connection.CreateCommand('CREATE SCHEMA dext_ut_b').Execute;

    DbA.Connection.CreateCommand('SET search_path TO dext_ut_a').Execute;
    DbA.EnsureCreated;
    Should(RelationExists(DbA, 'dext_ut_a')).BeTrue;

    // The same table name already exists in schema A: schema B still needs it.
    DbB.Connection.CreateCommand('SET search_path TO dext_ut_b').Execute;
    DbB.EnsureCreated;
    Should(RelationExists(DbB, 'dext_ut_b')).BeTrue;

    DbA.Connection.CreateCommand('DROP SCHEMA dext_ut_a CASCADE').Execute;
    DbA.Connection.CreateCommand('DROP SCHEMA dext_ut_b CASCADE').Execute;
  finally
    DbA.Free;
    DbB.Free;
  end;
end;

procedure TPostgreSQLSchemaTests.Dynamic_Array_Round_Trips_Through_Jsonb;
var
  Db: TPgArrayDb;
  Item: TPgArrayThing;
begin
  if Connection = '' then
    Exit; // no server configured

  if GLink = nil then
    NewDb.Free;
  Db := TPgArrayDb.Create(DbContextOptions.UsePostgreSQL(Connection));
  try
    Db.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_c CASCADE').Execute;
    Db.Connection.CreateCommand('CREATE SCHEMA dext_ut_c').Execute;
    Db.Connection.CreateCommand('SET search_path TO dext_ut_c').Execute;
    Db.EnsureCreated;

    Item := TPgArrayThing.Create;
    Item.Tags := ['a', 'b', 'c'];
    Db.Items.Add(Item);
    Db.SaveChanges;
    Db.Clear;

    Should(Db.Items.ToList[0].Tags[1]).Be('b');
    Db.Connection.CreateCommand('DROP SCHEMA dext_ut_c CASCADE').Execute;
  finally
    Db.Free;
  end;
end;

procedure TPostgreSQLSchemaTests.Guid_Round_Trips_Through_A_Uuid_Column;
var
  Db: TPgArrayDb;
  Item: TPgArrayThing;
  Original: TGUID;
begin
  if Connection = '' then
    Exit; // no server configured

  if GLink = nil then
    NewDb.Free;
  // Every field differs, so a byte swap of D1, D2 or D3 shows
  Original := StringToGUID('{AB8CB5AC-0B92-4DFB-A328-BD55F8DC31A7}');
  Db := TPgArrayDb.Create(DbContextOptions.UsePostgreSQL(Connection));
  try
    Db.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_d CASCADE').Execute;
    Db.Connection.CreateCommand('CREATE SCHEMA dext_ut_d').Execute;
    Db.Connection.CreateCommand('SET search_path TO dext_ut_d').Execute;
    Db.EnsureCreated;

    Item := TPgArrayThing.Create;
    Item.Ident := Original;
    Db.Items.Add(Item);
    Db.SaveChanges;
    Db.Clear;

    Should(GUIDToString(Db.Items.ToList[0].Ident)).Be(GUIDToString(Original));
    Db.Connection.CreateCommand('DROP SCHEMA dext_ut_d CASCADE').Execute;
  finally
    Db.Free;
  end;
end;

procedure TPostgreSQLSchemaTests.Guids_Of_Several_Entities_Are_Inserted_Together;
var
  Db: TPgGuidBatchDb;
  First, Second: TPgGuidBatch;
  Reader: IDbReader;
begin
  if Connection = '' then
    Exit; // no server configured

  if GLink = nil then
    NewDb.Free;
  Db := TPgGuidBatchDb.Create(DbContextOptions.UsePostgreSQL(Connection));
  try
    Db.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_e CASCADE').Execute;
    Db.Connection.CreateCommand('CREATE SCHEMA dext_ut_e').Execute;
    Db.Connection.CreateCommand('SET search_path TO dext_ut_e').Execute;
    Db.EnsureCreated;

    // Two rows in one SaveChanges take the array (batch) insert path.
    First := TPgGuidBatch.Create;
    First.Id := 1;
    First.Ident := StringToGUID('{AB8CB5AC-0B92-4DFB-A328-BD55F8DC31A7}');
    Second := TPgGuidBatch.Create;
    Second.Id := 2;
    Second.Ident := StringToGUID('{12345678-9ABC-4DEF-8123-56789ABCDEF0}');
    Db.Items.Add(First);
    Db.Items.Add(Second);
    Should(Db.SaveChanges).Be(2);
    Db.Clear;

    Should(Db.Items.ToList.Count).Be(2);

    // The server holds the same text a single-row insert would store.
    Reader := Db.Connection.CreateCommand(
      'SELECT "Ident"::text FROM pg_guid_batch WHERE "Id" = 1').ExecuteQuery;
    Should(Reader.Next).BeTrue;
    Should(Reader.GetString(0)).Be('ab8cb5ac-0b92-4dfb-a328-bd55f8dc31a7');
    Db.Connection.CreateCommand('DROP SCHEMA dext_ut_e CASCADE').Execute;
  finally
    Db.Free;
  end;
end;

procedure TPostgreSQLSchemaTests.Arrays_Of_Several_Entities_Are_Inserted_Together;
var
  Db: TPgGuidBatchDb;
  First, Second: TPgGuidBatch;
begin
  if Connection = '' then
    Exit; // no server configured

  if GLink = nil then
    NewDb.Free;
  Db := TPgGuidBatchDb.Create(DbContextOptions.UsePostgreSQL(Connection));
  try
    Db.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_f CASCADE').Execute;
    Db.Connection.CreateCommand('CREATE SCHEMA dext_ut_f').Execute;
    Db.Connection.CreateCommand('SET search_path TO dext_ut_f').Execute;
    Db.EnsureCreated;

    First := TPgGuidBatch.Create;
    First.Id := 1;
    First.Tags := ['a'];
    Second := TPgGuidBatch.Create;
    Second.Id := 2;
    Second.Tags := ['b', 'c'];
    Db.Items.Add(First);
    Db.Items.Add(Second);
    Should(Db.SaveChanges).Be(2);
    Db.Clear;

    Should(Length(Db.Items.ToList[1].Tags)).Be(2);
    Db.Connection.CreateCommand('DROP SCHEMA dext_ut_f CASCADE').Execute;
  finally
    Db.Free;
  end;
end;

procedure TPostgreSQLSchemaTests.Entity_With_Only_The_Generated_Key_Is_Inserted;
var
  Db: TPgOnlyKeyDb;
  First, Second: TPgOnlyKey;
begin
  if Connection = '' then
    Exit; // no server configured

  if GLink = nil then
    NewDb.Free;
  Db := TPgOnlyKeyDb.Create(DbContextOptions.UsePostgreSQL(Connection));
  try
    Db.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_g CASCADE').Execute;
    Db.Connection.CreateCommand('CREATE SCHEMA dext_ut_g').Execute;
    Db.Connection.CreateCommand('SET search_path TO dext_ut_g').Execute;
    Db.EnsureCreated;

    First := TPgOnlyKey.Create;
    Second := TPgOnlyKey.Create;
    Db.Items.Add(First);
    Db.Items.Add(Second);
    Should(Db.SaveChanges).Be(2);

    // The key comes back through RETURNING.
    Should(First.Id).Be(1);
    Should(Second.Id).Be(2);
    Db.Connection.CreateCommand('DROP SCHEMA dext_ut_g CASCADE').Execute;
  finally
    Db.Free;
  end;
end;

procedure TPostgreSQLSchemaTests.Scaffolding_Reads_Identity_Columns_As_AutoInc;
var
  Db: TPgOnlyKeyDb;
  Provider: ISchemaProvider;
  Serial, Identity, Plain: TMetaTable;
begin
  if Connection = '' then
    Exit; // no server configured

  if GLink = nil then
    NewDb.Free;
  Db := TPgOnlyKeyDb.Create(DbContextOptions.UsePostgreSQL(Connection));
  try
    Db.Connection.CreateCommand('DROP SCHEMA IF EXISTS dext_ut_s CASCADE').Execute;
    Db.Connection.CreateCommand('CREATE SCHEMA dext_ut_s').Execute;
    Db.Connection.CreateCommand('SET search_path TO dext_ut_s').Execute;
    Db.Connection.CreateCommand(
      'CREATE TABLE sc_serial (id SERIAL PRIMARY KEY, name text)').Execute;
    Db.Connection.CreateCommand(
      'CREATE TABLE sc_identity (id bigint GENERATED ALWAYS AS IDENTITY ' +
      'PRIMARY KEY, name text)').Execute;
    Db.Connection.CreateCommand(
      'CREATE TABLE sc_plain (id integer PRIMARY KEY, name text)').Execute;

    // The provider reads the schema named by this connection parameter.
    TFireDACConnection(Db.Connection).Connection.Params.Values['MetaCurSchema'] :=
      'dext_ut_s';
    Provider := TFireDACSchemaProvider.Create(Db.Connection);
    Serial := Provider.GetTableMetadata('sc_serial');
    Identity := Provider.GetTableMetadata('sc_identity');
    Plain := Provider.GetTableMetadata('sc_plain');

    Should(Serial.Columns[0].IsAutoInc).BeTrue;
    Should(Identity.Columns[0].IsAutoInc).Because('identity is generated too').BeTrue;
    Should(Plain.Columns[0].IsAutoInc).BeFalse;

    Provider := nil;
    Db.Connection.CreateCommand('DROP SCHEMA dext_ut_s CASCADE').Execute;
  finally
    Db.Free;
  end;
end;

function TPgOnlyKeyDb.GetItems: IDbSet<TPgOnlyKey>;
begin
  Result := Entities<TPgOnlyKey>;
end;

function TPgGuidBatchDb.GetItems: IDbSet<TPgGuidBatch>;
begin
  Result := Entities<TPgGuidBatch>;
end;

function TPgArrayDb.GetItems: IDbSet<TPgArrayThing>;
begin
  Result := Entities<TPgArrayThing>;
end;

initialization

finalization
  GLink.Free;

end.
